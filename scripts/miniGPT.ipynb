def decode(ids, itos):
    return ''.join(itos[i] for i in ids)

def get_example(data_ids, block_size):
    start = random.randint(0, len(data_ids) - block_size - 1)
    chunk = data_ids[start:start + block_size + 1]
    x = chunk[:-1]
    y = chunk[1:]
    return x, y

def eval_loss(model, data_ids, vocab_size, block_size, n_batches=20):
    total = 0.0
    for _ in range(n_batches):
        x_ids, y_ids = get_example(data_ids, block_size)
        logits = model(x_ids)
        loss = cross_entropy_loss(logits, y_ids, vocab_size)
        total += loss.data[0][0]
    return total / n_batches

def sample_from_logits(logit_row, temperature=1.0):
    scaled = [x / temperature for x in logit_row]
    m = max(scaled)
    exps = [math.exp(x - m) for x in scaled]
    s = sum(exps)
    probs = [e / s for e in exps]
    return random.choices(range(len(probs)), weights=probs, k=1)[0]

def generate(model, seed_ids, max_new_tokens, block_size, temperature=1.0):
    ids = seed_ids[:]
    for _ in range(max_new_tokens):
        ctx = ids[-block_size:]
        logits = model(ctx)
        next_id = sample_from_logits(logits.data[-1], temperature=temperature)
        ids.append(next_id)
    return ids

# Load dataset
import urllib.request

# Download the full Tiny Shakespeare corpus
url = "https://raw.githubusercontent.com/karpathy/char-rnn/master/data/tinyshakespeare/input.txt"
with urllib.request.urlopen(url) as f:
    text = f.read().decode('utf-8')

chars = sorted(set(text))
stoi = {ch: i for i, ch in enumerate(chars)}
itos = {i: ch for ch, i in stoi.items()}
vocab_size = len(chars)

data = [stoi[ch] for ch in text]
split = int(0.9 * len(data))
train_ids = data[:split]
val_ids = data[split:]

random.seed(42)

block_size = 32

model = TransformerLM(
    vocab_size=vocab_size,
    d_model=32,
    n_heads=4,
    head_size=8,
    hidden_dim=64,
    n_layers=12,
    max_len=block_size,
)

params = model.parameters()
lr = 0.01

for step in range(1000001):
    x_ids, y_ids = get_example(train_ids, block_size)

    zero_grad(params)
    logits = model(x_ids)
    loss = cross_entropy_loss(logits, y_ids, vocab_size)
    loss.backward()
    sgd_step(params, lr)

    if step % 50 == 0:
        train_loss = loss.data[0][0]
        val_loss = eval_loss(model, val_ids, vocab_size, block_size, n_batches=10)

        print(f"step {step:4d} | train loss {train_loss:.4f} | val loss {val_loss:.4f}")

        seed = [stoi[ch] for ch in "First " if ch in stoi]
        out_ids = generate(model, seed, max_new_tokens=80, block_size=block_size, temperature=0.8)
        print(repr(decode(out_ids, itos)))
        print()
