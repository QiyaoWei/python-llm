def step_optimizer(parameters, lr=0.01):
    for p in parameters:
        for i in range(p.shape[0]):
            for j in range(p.shape[1]):
                p.data[i][j] -= lr * p.grad[i][j]
        # Crucial: Reset for next pass
        p.zero_grad()

def cross_entropy_2d(logits, target_indices):
    """
    logits: Tensor2D of shape (T, Vocab)
    target_indices: List of integers [idx1, idx2, ... idxT]
    """
    T, V = logits.shape

    # 1. Max for stability: (T x 1)
    row_maxes = logits.max_row()

    # 2. Shift logits: (T x V) - (T x 1)
    # Note: Using your __add__ with broadcasting logic
    shifted = logits + (row_maxes * -1.0)

    # 3. Log-Sum-Exp: log(sum(exp(shifted))) + row_maxes
    # exp().sum_row() results in (T x 1)
    lse = shifted.exp().sum_row().log() + row_maxes

    # 4. Get the logits for the actual correct tokens: (T x 1)
    correct_logits = logits.get_targets(target_indices)

    # 5. Average loss over the sequence
    # (lse - correct_logits) is (T x 1). We sum all and divide by T.
    total_loss = (lse - correct_logits).sum_all()

    return total_loss * (1.0 / T)

import urllib.request

# Download the full Tiny Shakespeare corpus
url = "https://raw.githubusercontent.com/karpathy/char-rnn/master/data/tinyshakespeare/input.txt"
with urllib.request.urlopen(url) as f:
    text = f.read().decode('utf-8')

chars = sorted(list(set(text)))
vocab_size = len(chars)
stoi = { ch:i for i,ch in enumerate(chars) }
itos = { i:ch for i,ch in enumerate(chars) }
encode = lambda s: [stoi[c] for c in s]

# --- HYPERPARAMETERS ---
EMBED_DIM = 64   # Higher capacity for the 1MB corpus
N_HEADS = 4
N_LAYERS = 2     # Let's try stacking two layers
BLOCK_SIZE = 32  # Longer context
LR = 0.001       # Lower learning rate for a larger dataset
ITERATIONS = 1

model = TinyTransformer(vocab_size, EMBED_DIM, N_HEADS, N_LAYERS)
params = model.parameters()

print(f"Dataset loaded: {len(text)} characters. Vocab size: {vocab_size}")
print(f"Estimated parameters: ~{sum(p.shape[0]*p.shape[1] for p in params)}")

for i in range(ITERATIONS):
    # 1. Random batch sampling
    idx = random.randint(0, len(text) - BLOCK_SIZE - 1)
    ix = encode(text[idx : idx + BLOCK_SIZE])
    iy = encode(text[idx + 1 : idx + BLOCK_SIZE + 1])

    # 2. Forward
    logits = model(ix)
    loss = cross_entropy_2d(logits, iy)

    # 3. Backward
    for p in params: p.zero_grad()
    loss.backward()

    # 4. Optimizer (SGD)
    for p in params:
        for r in range(p.shape[0]):
            for c in range(p.shape[1]):
                p.data[r][c] -= LR * p.grad[r][c]

    # 5. Memory Cleanup
    # We clear the graph completely to prevent RAM bloat
    topo = []
    visited = set()
    def build_topo(v):
        if v not in visited:
            visited.add(v)
            for child in v._prev: build_topo(child)
            topo.append(v)
    build_topo(loss)
    for node in topo: node.clear_graph()

