import random
import math

class Tensor2D:
    def __init__(self, data, _children=(), _op=''):
        self.data = data
        self.shape = (len(data), len(data[0]) if data else 0)
        self.grad = [[0.0] * self.shape[1] for _ in range(self.shape[0])]
        self._children = _children
        self._op = _op
        self._prev = set(_children)
        self._backward = lambda: None

    def __matmul__(self, other):
        if not isinstance(other, Tensor2D):
            raise TypeError("@ only supports Tensor2D @ Tensor2D")

        M, K = self.shape
        K2, N = other.shape

        if K != K2:
            raise ValueError(f"Shapes {self.shape} and {other.shape} not compatible for matmul")

        a = self.data
        b = other.data

        # Forward: (M, K) @ (K, N) -> (M, N)
        data = [[0.0] * N for _ in range(M)]
        for i in range(M):
            arow = a[i]
            outrow = data[i]
            for k in range(K):
                aik = arow[k]
                brow = b[k]
                for j in range(N):
                    outrow[j] += aik * brow[j]

        out = Tensor2D(data, (self, other), '@')

        def _backward():
            outg = out.grad
            selfg = self.grad
            otherg = other.grad

            # dA[i][k] += sum_j dOut[i][j] * B[k][j]
            # dB[k][j] += sum_i A[i][k] * dOut[i][j]
            for i in range(M):
                arow = a[i]
                outgi = outg[i]
                selfgi = selfg[i]

                for k in range(K):
                    aik = arow[k]
                    brow = b[k]
                    othergk = otherg[k]

                    s = 0.0
                    for j in range(N):
                        g = outgi[j]
                        s += g * brow[j]
                        othergk[j] += aik * g

                    selfgi[k] += s

        out._backward = _backward
        return out

    def __add__(self, other):
        if not isinstance(other, Tensor2D):
            if isinstance(other, (int, float)):
                other = Tensor2D([[other]])
            else:
                raise TypeError("other must be Tensor2D or scalar")

        M, N = self.shape
        oM, oN = other.shape

        if (M, N) == (oM, oN):
            data = [[self.data[i][j] + other.data[i][j] for j in range(N)] for i in range(M)]

        elif (M, N) == (1, 1):
            data = [[self.data[0][0] + other.data[i][j] for j in range(oN)] for i in range(oM)]

        elif (oM, oN) == (1, 1):
            data = [[self.data[i][j] + other.data[0][0] for j in range(N)] for i in range(M)]

        elif (oM, oN) == (M, 1):  # other column-broadcasts across columns
            data = [[self.data[i][j] + other.data[i][0] for j in range(N)] for i in range(M)]

        elif (oM, oN) == (1, N):  # other row-broadcasts across rows
            data = [[self.data[i][j] + other.data[0][j] for j in range(N)] for i in range(M)]

        elif (M, N) == (oM, 1):  # self column-broadcasts across columns
            data = [[self.data[i][0] + other.data[i][j] for j in range(oN)] for i in range(oM)]

        elif (M, N) == (1, oN):  # self row-broadcasts across rows
            data = [[self.data[0][j] + other.data[i][j] for j in range(oN)] for i in range(oM)]

        else:
            raise ValueError(f"Shapes {self.shape} and {other.shape} not compatible for addition")

        out = Tensor2D(data, (self, other), '+')

        def _backward():
            if (M, N) == (oM, oN):
                for i in range(M):
                    for j in range(N):
                        self.grad[i][j] += out.grad[i][j]
                        other.grad[i][j] += out.grad[i][j]

            elif (M, N) == (1, 1):
                for i in range(oM):
                    for j in range(oN):
                        self.grad[0][0] += out.grad[i][j]
                        other.grad[i][j] += out.grad[i][j]

            elif (oM, oN) == (1, 1):
                for i in range(M):
                    for j in range(N):
                        self.grad[i][j] += out.grad[i][j]
                        other.grad[0][0] += out.grad[i][j]

            elif (oM, oN) == (M, 1):
                for i in range(M):
                    for j in range(N):
                        self.grad[i][j] += out.grad[i][j]
                        other.grad[i][0] += out.grad[i][j]

            elif (oM, oN) == (1, N):
                for i in range(M):
                    for j in range(N):
                        self.grad[i][j] += out.grad[i][j]
                        other.grad[0][j] += out.grad[i][j]

            elif (M, N) == (oM, 1):
                for i in range(oM):
                    for j in range(oN):
                        self.grad[i][0] += out.grad[i][j]
                        other.grad[i][j] += out.grad[i][j]

            elif (M, N) == (1, oN):
                for i in range(oM):
                    for j in range(oN):
                        self.grad[0][j] += out.grad[i][j]
                        other.grad[i][j] += out.grad[i][j]

        out._backward = _backward
        return out
    
    def __mul__(self, other):
        if not isinstance(other, Tensor2D):
            if isinstance(other, (int, float)):
                other = Tensor2D([[other]])
            else:
                raise TypeError("other must be Tensor2D or scalar")

        M, N = self.shape
        oM, oN = other.shape

        if (M, N) == (oM, oN):
            data = [[self.data[i][j] * other.data[i][j] for j in range(N)] for i in range(M)]

        elif (M, N) == (1, 1):
            data = [[self.data[0][0] * other.data[i][j] for j in range(oN)] for i in range(oM)]

        elif (oM, oN) == (1, 1):
            data = [[self.data[i][j] * other.data[0][0] for j in range(N)] for i in range(M)]

        elif (oM, oN) == (M, 1):  # other column-broadcasts across columns
            data = [[self.data[i][j] * other.data[i][0] for j in range(N)] for i in range(M)]

        elif (oM, oN) == (1, N):  # other row-broadcasts across rows
            data = [[self.data[i][j] * other.data[0][j] for j in range(N)] for i in range(M)]

        elif (M, N) == (oM, 1):  # self column-broadcasts across columns
            data = [[self.data[i][0] * other.data[i][j] for j in range(oN)] for i in range(oM)]

        elif (M, N) == (1, oN):  # self row-broadcasts across rows
            data = [[self.data[0][j] * other.data[i][j] for j in range(oN)] for i in range(oM)]

        else:
            raise ValueError(f"Shapes {self.shape} and {other.shape} not compatible for multiplication")

        out = Tensor2D(data, (self, other), '*')

        def _backward():
            if (M, N) == (oM, oN):
                for i in range(M):
                    for j in range(N):
                        self.grad[i][j] += other.data[i][j] * out.grad[i][j]
                        other.grad[i][j] += self.data[i][j] * out.grad[i][j]
            elif (M, N) == (1, 1):
                for i in range(oM):
                    for j in range(oN):
                        self.grad[0][0] += other.data[i][j] * out.grad[i][j]
                        other.grad[i][j] += self.data[0][0] * out.grad[i][j]
            elif (oM, oN) == (1, 1):
                for i in range(M):
                    for j in range(N):
                        self.grad[i][j] += other.data[0][0] * out.grad[i][j]
                        other.grad[0][0] += self.data[i][j] * out.grad[i][j]
            elif (oM, oN) == (M, 1):
                for i in range(M):
                    for j in range(N):
                        self.grad[i][j] += other.data[i][0] * out.grad[i][j]
                        other.grad[i][0] += self.data[i][j] * out.grad[i][j]
            elif (oM, oN) == (1, N):
                for i in range(M):
                    for j in range(N):
                        self.grad[i][j] += other.data[0][j] * out.grad[i][j]
                        other.grad[0][j] += self.data[i][j] * out.grad[i][j]
            elif (M, N) == (oM, 1):
                for i in range(oM):
                    for j in range(oN):
                        self.grad[i][0] += other.data[i][j] * out.grad[i][j]
                        other.grad[i][j] += self.data[i][0] * out.grad[i][j]
            elif (M, N) == (1, oN):
                for i in range(oM):
                    for j in range(oN):
                        self.grad[0][j] += other.data[i][j] * out.grad[i][j]
                        other.grad[i][j] += self.data[0][j] * out.grad[i][j]
        out._backward = _backward
        return out

    def __rmul__(self, other):
        return self * other
    
    def relu(self):
        M, N = self.shape
        data = [[self.data[i][j] if self.data[i][j] > 0 else 0.0 for j in range(N)] for i in range(M)]
        out = Tensor2D(data, (self,), 'ReLU')

        def _backward():
            for i in range(M):
                for j in range(N):
                    if self.data[i][j] > 0:
                        self.grad[i][j] += out.grad[i][j]

        out._backward = _backward
        return out
    
    def pow(self, exponent):
        # TODO: watch out for exponent zero
        data = [[self.data[i][j] ** exponent for j in range(self.shape[1])] for i in range(self.shape[0])]
        out = Tensor2D(data, (self,), f'pow({exponent})')
        def _backward():
            for i in range(self.shape[0]):
                for j in range(self.shape[1]):
                    self.grad[i][j] += exponent * (self.data[i][j] ** (exponent - 1)) * out.grad[i][j]
        out._backward = _backward
        return out
    
    def max_row(self):
        M, N = self.shape
        data = [[max(self.data[i])] for i in range(M)]   # shape (M, 1)
        out = Tensor2D(data, (self,), 'max_row')

        def _backward():
            for i in range(M):
                max_val = data[i][0]
                count = sum(1 for j in range(N) if self.data[i][j] == max_val)
                g = out.grad[i][0] / count

                for j in range(N):
                    if self.data[i][j] == max_val:
                        self.grad[i][j] += g

        out._backward = _backward
        return out
    
    def sum_row(self):
        M, N = self.shape
        data = [[sum(self.data[i])] for i in range(M)]   # shape (M, 1)
        out = Tensor2D(data, (self,), 'sum_row')

        def _backward():
            for i in range(M):
                g = out.grad[i][0]
                for j in range(N):
                    self.grad[i][j] += g

        out._backward = _backward
        return out
    
    def sum_all(self):
        M, N = self.shape
        data = [[sum(sum(row) for row in self.data)]]
        out = Tensor2D(data, (self,), 'sum_all')

        def _backward():
            g = out.grad[0][0]
            for i in range(M):
                for j in range(N):
                    self.grad[i][j] += g

        out._backward = _backward
        return out
    
    def exp(self):
        out_data = [[math.exp(x) for x in row] for row in self.data]
        out = Tensor2D(out_data, (self,), 'exp')
        def _backward():
            M, N = self.shape
            for i in range(M):
                for j in range(N):
                    self.grad[i][j] += out.data[i][j] * out.grad[i][j]
        out._backward = _backward
        return out
    
    def log(self):
        M, N = self.shape
        out_data = [[math.log(x) for x in row] for row in self.data]
        out = Tensor2D(out_data, (self,), 'log')

        def _backward():
            for i in range(M):
                for j in range(N):
                    self.grad[i][j] += out.grad[i][j] / self.data[i][j]

        out._backward = _backward
        return out
    
    def T(self):
        M, N = self.shape
        out_data = [[self.data[j][i] for j in range(M)] for i in range(N)]
        out = Tensor2D(out_data, (self,), 'T')

        def _backward():
            for i in range(M):
                for j in range(N):
                    self.grad[i][j] += out.grad[j][i]

        out._backward = _backward
        return out
    
    def softmax_row(self):
        M, N = self.shape
        out_data = []
        for i in range(M):
            row = self.data[i]
            max_val = max(row)
            exps = [math.exp(x - max_val) for x in row]
            sum_exps = sum(exps)
            out_data.append([e / sum_exps for e in exps])

        out = Tensor2D(out_data, (self,), 'softmax_row')

        def _backward():
            for i in range(M):
                p = out.data[i]      # softmax probabilities for row i
                g = out.grad[i]      # upstream gradient for row i
                dot = sum(pj * gj for pj, gj in zip(p, g))

                for j in range(N):
                    self.grad[i][j] += p[j] * (g[j] - dot)

        out._backward = _backward
        return out
    
    def layernorm(self, gamma=None, beta=None, eps=1e-5):
        M, N = self.shape

        # gamma and beta are per-feature parameters: shape (1, N)
        if gamma is not None:
            if not isinstance(gamma, Tensor2D) or gamma.shape != (1, N):
                raise ValueError(f"gamma must have shape (1, {N})")
            gamma_vals = gamma.data[0][:]   # cache forward values
        else:
            gamma_vals = [1.0] * N

        if beta is not None:
            if not isinstance(beta, Tensor2D) or beta.shape != (1, N):
                raise ValueError(f"beta must have shape (1, {N})")
            beta_vals = beta.data[0][:]
        else:
            beta_vals = [0.0] * N

        xhats = []
        invstds = []
        out_data = []

        for i in range(M):
            row = self.data[i]
            mean = sum(row) / N
            var = sum((x - mean) ** 2 for x in row) / N
            invstd = 1.0 / math.sqrt(var + eps)

            xhat = [(x - mean) * invstd for x in row]
            yrow = [xhat[j] * gamma_vals[j] + beta_vals[j] for j in range(N)]

            xhats.append(xhat)
            invstds.append(invstd)
            out_data.append(yrow)

        parents = [self]
        if gamma is not None:
            parents.append(gamma)
        if beta is not None:
            parents.append(beta)

        out = Tensor2D(out_data, tuple(parents), 'layernorm')

        def _backward():
            for i in range(M):
                xhat = xhats[i]
                g = out.grad[i]

                # affine grads
                if gamma is not None:
                    dxhat = [g[j] * gamma_vals[j] for j in range(N)]
                    for j in range(N):
                        gamma.grad[0][j] += g[j] * xhat[j]
                else:
                    dxhat = g[:]

                if beta is not None:
                    for j in range(N):
                        beta.grad[0][j] += g[j]

                # layernorm backward into self
                mean_dxhat = sum(dxhat) / N
                mean_dxhat_xhat = sum(dxhat[j] * xhat[j] for j in range(N)) / N
                invstd = invstds[i]

                for j in range(N):
                    self.grad[i][j] += (dxhat[j] - mean_dxhat - xhat[j] * mean_dxhat_xhat) * invstd

        out._backward = _backward
        return out
    
    def apply_causal_mask(self):
        """
        Mask future positions in a square attention score matrix.
        Input:  (T, T)
        Output: (T, T)
        """
        M, N = self.shape
        if M != N:
            raise ValueError("Masking only works on square attention matrices (T x T)")

        neg_inf = float('-inf')
        out_data = []

        for i in range(M):
            row = []
            for j in range(N):
                if j > i:
                    row.append(neg_inf)
                else:
                    row.append(self.data[i][j])
            out_data.append(row)

        out = Tensor2D(out_data, (self,), 'causal_mask')

        def _backward():
            for i in range(M):
                for j in range(i + 1):   # only unmasked positions
                    self.grad[i][j] += out.grad[i][j]

        out._backward = _backward
        return out
    
    def zero_grad(self):
        M, N = self.shape
        for i in range(M):
            for j in range(N):
                self.grad[i][j] = 0.0

    def backward(self):
        topo = []
        visited = set()

        def build_topo(v):
            if v not in visited:
                visited.add(v)
                for parent in v._prev:
                    build_topo(parent)
                topo.append(v)

        build_topo(self)

        if self.shape != (1, 1):
            raise ValueError("backward() can only be called on a scalar tensor")

        self.grad[0][0] = 1.0

        for v in reversed(topo):
            v._backward()


class LinearLayer:
    def __init__(self, nin, nout):
        scale = (6.0 / (nin + nout)) ** 0.5
        self.W = Tensor2D([
            [random.uniform(-scale, scale) for _ in range(nout)]
            for _ in range(nin)
        ])
        self.b = Tensor2D([[0.0 for _ in range(nout)]])

    def __call__(self, x):
        return (x @ self.W) + self.b

    def parameters(self):
        return [self.W, self.b]


class FeedForward:
    def __init__(self, dim, hidden_dim):
        self.w1 = LinearLayer(dim, hidden_dim)
        self.w2 = LinearLayer(hidden_dim, dim)

    def __call__(self, x):
        return self.w2(self.w1(x).relu())

    def parameters(self):
        return self.w1.parameters() + self.w2.parameters()


class AttentionHead:
    def __init__(self, nin, head_size):
        self.Wq = LinearLayer(nin, head_size)
        self.Wk = LinearLayer(nin, head_size)
        self.Wv = LinearLayer(nin, head_size)
        self.head_size = head_size

    def __call__(self, x, mask=True):
        # x: (T, nin)
        Q = self.Wq(x)   # (T, head_size)
        K = self.Wk(x)   # (T, head_size)
        V = self.Wv(x)   # (T, head_size)

        scores = (Q @ K.T()) * (1.0 / math.sqrt(self.head_size))   # (T, T)

        if mask:
            scores = scores.apply_causal_mask()

        weights = scores.softmax_row()   # (T, T)
        return weights @ V               # (T, head_size)

    def parameters(self):
        return (
            self.Wq.parameters()
            + self.Wk.parameters()
            + self.Wv.parameters()
        )


class MultiHeadAttention:
    def __init__(self, nin, n_heads, head_size):
        self.n_heads = n_heads
        self.head_size = head_size
        self.heads = [AttentionHead(nin, head_size) for _ in range(n_heads)]

        # These are the per-head blocks of the usual big W_out.
        # Each maps (head_size) -> (nin).
        scale = (6.0 / (head_size + nin)) ** 0.5
        self.W_out_blocks = [
            Tensor2D([
                [random.uniform(-scale, scale) for _ in range(nin)]
                for _ in range(head_size)
            ])
            for _ in range(n_heads)
        ]

        # One shared final bias, same as the usual single output projection.
        self.b_out = Tensor2D([[0.0 for _ in range(nin)]])

    def __call__(self, x, mask=True):
        # x: (T, nin)
        out = None

        for head, W_out in zip(self.heads, self.W_out_blocks):
            head_out = head(x, mask=mask)   # (T, head_size)
            proj = head_out @ W_out         # (T, nin)

            if out is None:
                out = proj
            else:
                out = out + proj

        return out + self.b_out            # (T, nin)

    def parameters(self):
        params = []
        for h in self.heads:
            params.extend(h.parameters())
        params.extend(self.W_out_blocks)
        params.append(self.b_out)
        return params
    
class TransformerBlock:
    def __init__(self, d_model, n_heads, head_size, hidden_dim):
        self.ln1_gamma = Tensor2D([[1.0] * d_model])
        self.ln1_beta  = Tensor2D([[0.0] * d_model])
        self.ln2_gamma = Tensor2D([[1.0] * d_model])
        self.ln2_beta  = Tensor2D([[0.0] * d_model])

        self.attn = MultiHeadAttention(d_model, n_heads, head_size)
        self.ff = FeedForward(d_model, hidden_dim)

    def __call__(self, x):
        x = x + self.attn(x.layernorm(self.ln1_gamma, self.ln1_beta), mask=True)
        x = x + self.ff(x.layernorm(self.ln2_gamma, self.ln2_beta))
        return x

    def parameters(self):
        return (
            [self.ln1_gamma, self.ln1_beta, self.ln2_gamma, self.ln2_beta]
            + self.attn.parameters()
            + self.ff.parameters()
        )
    
class Embedding:
    def __init__(self, vocab_size, d_model):
        scale = (6.0 / (vocab_size + d_model)) ** 0.5
        self.W = Tensor2D([
            [random.uniform(-scale, scale) for _ in range(d_model)]
            for _ in range(vocab_size)
        ])

    def __call__(self, token_ids):
        # token_ids: list of ints, shape (T,)
        vocab_size, d_model = self.W.shape

        out_data = []
        for token_id in token_ids:
            if not (0 <= token_id < vocab_size):
                raise IndexError(f"token id {token_id} out of range [0, {vocab_size})")
            out_data.append(self.W.data[token_id][:])   # copy row

        out = Tensor2D(out_data, (self.W,), 'embedding')

        def _backward():
            for t, token_id in enumerate(token_ids):
                for j in range(d_model):
                    self.W.grad[token_id][j] += out.grad[t][j]

        out._backward = _backward
        return out

    def parameters(self):
        return [self.W]
    

class TransformerLM:
    def __init__(self, vocab_size, d_model, n_heads, head_size, hidden_dim, n_layers, max_len):
        self.tok_emb = Embedding(vocab_size, d_model)
        self.pos_emb = Embedding(max_len, d_model)

        self.blocks = [
            TransformerBlock(d_model, n_heads, head_size, hidden_dim)
            for _ in range(n_layers)
        ]

        self.ln_f_gamma = Tensor2D([[1.0] * d_model])
        self.ln_f_beta  = Tensor2D([[0.0] * d_model])

        # simplest: separate LM head
        scale = (6.0 / (d_model + vocab_size)) ** 0.5
        self.W_vocab = Tensor2D([
            [random.uniform(-scale, scale) for _ in range(vocab_size)]
            for _ in range(d_model)
        ])
        self.b_vocab = Tensor2D([[0.0 for _ in range(vocab_size)]])

    def __call__(self, token_ids):
        T = len(token_ids)

        x = self.tok_emb(token_ids) + self.pos_emb(list(range(T)))

        for block in self.blocks:
            x = block(x)

        x = x.layernorm(self.ln_f_gamma, self.ln_f_beta)
        logits = (x @ self.W_vocab) + self.b_vocab   # (T, vocab_size)
        return logits

    def parameters(self):
        params = []
        params.extend(self.tok_emb.parameters())
        params.extend(self.pos_emb.parameters())
        for block in self.blocks:
            params.extend(block.parameters())
        params.extend([self.ln_f_gamma, self.ln_f_beta, self.W_vocab, self.b_vocab])
        return params


def one_hot(token_ids, vocab_size):
    return Tensor2D([
        [1.0 if j == tok else 0.0 for j in range(vocab_size)]
        for tok in token_ids
    ])

def cross_entropy_loss(logits, target_ids, vocab_size):
    # stable log-softmax
    shifted = logits + (-1.0) * logits.max_row()              # (T, V)
    log_probs = shifted + (-1.0) * shifted.exp().sum_row().log()

    targets = one_hot(target_ids, vocab_size)                 # constant
    loss = (targets * log_probs).sum_all() * (-1.0 / len(target_ids))
    return loss

def zero_grad(params):
    for p in params:
        p.zero_grad()

def sgd_step(params, lr):
    for p in params:
        M, N = p.shape
        for i in range(M):
            for j in range(N):
                p.data[i][j] -= lr * p.grad[i][j]

