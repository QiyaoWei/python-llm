def cross_entropy_2d(logits, target_indices):
    """
    logits: Tensor2D of shape (T, Vocab)
    target_indices: List of integers [idx1, idx2, ... idxT]
    """
    T, V = logits.shape

    # 1. Max for stability: (T x 1)
    row_maxes = logits.max_row()

    # 2. Shift logits: (T x V) - (T x 1)
    # Note: Using your __add__ with broadcasting logic
    shifted = logits + (row_maxes * -1.0)

    # 3. Log-Sum-Exp: log(sum(exp(shifted))) + row_maxes
    # exp().sum_row() results in (T x 1)
    lse = shifted.exp().sum_row().log() + row_maxes

    # 4. Get the logits for the actual correct tokens: (T x 1)
    correct_logits = logits.get_targets(target_indices)

    # 5. Average loss over the sequence
    # (lse - correct_logits) is (T x 1). We sum all and divide by T.
    loss = (lse - correct_logits).sum_row()
    # sum_row on a (T x 1) results in a (1 x 1) containing the total sum
    total_loss = loss.sum_row()

    return total_loss * (1.0 / T)

