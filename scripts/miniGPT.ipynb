encode = lambda s: [stoi[c] for c in s]

# --- 2. HYPERPARAMETERS ---
# To reach 1M params, you'd increase these significantly
EMBED_DIM = 16
N_HEADS = 2
N_LAYERS = 6
LR = 0.01
EPOCHS = 100
BLOCK_SIZE = 8 # Sequence length

# --- 3. INITIALIZATION ---
model = TinyTransformer(vocab_size, EMBED_DIM, N_HEADS, N_LAYERS)
params = model.parameters()

print(f"Training started on {vocab_size} unique characters...")

# --- 4. TRAINING LOOP ---
for epoch in range(EPOCHS):
    # Grab a random chunk of text
    start_idx = random.randint(0, len(text) - BLOCK_SIZE - 1)
    chunk = text[start_idx : start_idx + BLOCK_SIZE + 1]

    # X is the sequence, Y is the sequence shifted by one (the targets)
    ix = encode(chunk[:-1])
    iy = encode(chunk[1:])

    # --- FORWARD ---
    logits = model(ix) # Shape: (BLOCK_SIZE, vocab_size)
    loss = cross_entropy_2d(logits, iy)

    # --- BACKWARD ---
    # 1. Zero out old gradients
    for p in params: p.zero_grad()

    # 2. Backpropagate
    loss.backward()

    # --- UPDATE (Optimizer Step) ---
    for p in params:
        for i in range(p.shape[0]):
            for j in range(p.shape[1]):
                p.data[i][j] -= LR * p.grad[i][j]

    # --- MEMORY CLEANUP ---
    # This is what keeps the "Million Parameter" model from crashing your PC
    # We must break the graph links so Python can free the memory
    def clear_all(node):
        node._prev = set()
        node._backward = lambda: None

    # Use a simple topo-sort or just a set of all nodes if you track them
    # For now, let's clear the loss graph
    topo = []
    visited = set()
    def build_topo(v):
        if v not in visited:
            visited.add(v)
            for child in v._prev: build_topo(child)
            topo.append(v)
    build_topo(loss)
    for node in topo: node.clear_graph()

    if epoch % 10 == 0:
        print(f"Epoch {epoch} | Loss: {loss.data[0][0]:.4f}")
